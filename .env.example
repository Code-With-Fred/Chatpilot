# Copy this file to .env and fill in your real values.

# Required — Claude API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# Required — protects /admin.html and the /api/admin/* endpoints.
# Pick a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=change_me_to_a_long_random_string

PORT=3000

# Optional — if set, lead notification emails are sent to each client's
# contactEmail whenever their widget captures a lead. Leave blank to skip
# email and rely on the admin dashboard's Leads table instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_FROM=
